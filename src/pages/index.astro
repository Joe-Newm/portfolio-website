---
import Layout from "../layouts/Layout.astro";
import Project from "../components/Project.astro";
import Social from "../components/Social.astro";
import Projectclick from "../components/Projectclick.astro";
import ContactForm from "../components/ContactForm.astro";
import SocialBig from "../components/SocialBig.astro";
---

<Layout title="Welcome to Astro.">
  <main>
    <div
      id="bio-container"
      class="mb-4 flex flex-col lg:flex-row lg:justify-between gap-10"
    >
      <div>
        <img
          id="selfie"
          class="w-96"
          src="img/self-portrait.jpg"
          alt="portrait of Joseph Newman in black and white."
        />
      </div>
      <div class="basis-full">
        <h1>Hi, I'm Joseph Newman</h1>
        <!-- <p class="text-gray-600">
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed
                    do eiusmod tempor incididunt ut labore et dolore magna
                    aliqua. Ut enim ad minim veniam, quis nostrud exercitation
                    ullamco laboris nisi ut aliquip ex ea commodo consequat.
                </p> -->
        <p class="text-gray-600">
          I’m a full-stack developer with a background in UI/UX and graphic design. I focus on building responsive, user-friendly web apps with React on the front end and Node.js (express) or Java (Spring Boot) on the back end. I like working on projects from start to finish: designing clean interfaces, writing solid code, and making sure everything works smoothly together. I care about both how things look and how they perform.
        </p>
        <div class="flex gap-4 mt-5">
          <Social socialName="Github" link="https://github.com/Joe-Newm" />
          <Social
            socialName="Linkedin"
            link="https://linkedin.com/in/joseph-newman-a54900159"
          />
          <Social socialName="Resume" link="/documents/Joseph-Newman-Resume.pdf"/>
        </div>
      </div>
    </div>

    <div class="mb-20 border border-gray-400 rounded-md p-5 mb-20">
      <img
        src="https://ghchart.rshah.org/joe-newm"
        class="w-full"
        alt="GitHub Contributions"
      />
    </div>

    <h2 class=" font-semibold">Selected Projects</h2>
    <hr class="mb-5 border-black"/>
    <div class="md:grid-cols-2 grid gap-4 ">
    <Project
      github={"https://github.com/Joe-Newm/art-portfolio-creator.git"}
      projectName={"Art Portfolio CMS"}
      tools={["react", "node.js", "firebase"]}
      link={"https://art-portfolio-creator.netlify.app/login"}
      projectDescription={"Art Portfolio Creator is a customizable content management app built with React and Firebase (Realtime Database & Storage). It allows artists to build and manage their own portfolio website without writing code. Users can log into a secure dashboard to update the site’s name, hero image, about page, and create/edit art posts with images and descriptions."}
      img="/img/Screenshot-art-portfolio-creator.png"
      altText="Image of Art Portfolio Creator Dashboard"
      size="680px"
      />
    <Project
      github={"https://github.com/Joe-Newm/techsavvy-wordpress-theme"}
      projectName={"Techsavvy Business Website"}
      tools={["custom wordpress theme", "PHP", "bootstrap"]}
      link={"https://techsavvy.llc/"}
      projectDescription={"I designed and developed a custom WordPress theme for Techsavvy LLC, a managed IT service provider. The project included full-stack development using HTML, CSS, and PHP, along with complete branding — I created the logo, selected color schemes, and designed the entire user experience from scratch. The site features dynamic contact and referral forms."}
      img="/img/Home-Techsavvy-Website(1).png"
      altText="Image of Techsavvy Website homepage"
      size="680px"
    />
    <Project
      github={"https://github.com/Joe-Newm/techsavvy-react-native"}
      projectName={"Techsavvy Hub App"}
      tools={["react native", "node.js", "express.js"]}
      link={"https://apps.apple.com/us/app/techsavvy-hub/id6742513587"}
      projectDescription={"I developed the Techsavvy Hub mobile app using React Native for the frontend and Express.js for the backend. The app allows clients to submit detailed service requests, which are sent directly to ConnectWise Manage via its API. Submissions include priority, due date, and category, and the backend automatically matches the user’s email to their contact record in ConnectWise, assigning the ticket accordingly."}
      img="/img/techsavvy-hub-app.jpg"
      altText="Image of ad to download techsavvy-hub-app"
      size="680px"
    />
    <Project
      github={"https://github.com/Joe-Newm/pokemon-tcg-web"}
      projectName={"Pokemon-TCG Website"}
      tools={["javascript", "node.js", "express.js", "ejs"]}
      link={"https://pokemon-tcg-web.fly.dev/"}
      img="/img/pokemon-tcg.png"
      altText="image of pokemon-tcg website homepage"
      projectDescription="This full-stack web app allows users to browse, search, and explore Pokémon trading cards with detailed information including pricing, stats, and artwork. The site integrates with the Pokémon TCG API to display dynamic card data. Users can search cards by name using a live search bar and navigate through results with server-side pagination for a smooth, responsive experience. "
      size="680px"
    />

    <!--         
        <Projectclick
            github={"https://github.com/Joe-Newm/pixel-art-editor"}
            projectName={"Pixel Art Editor (Download)"}
            tools={["python", "pyside6"]}
        /> 
        -->
    </div>




    <h2 class=" mt-20 font-semibold">Game Projects</h2>
    <hr class="mb-5 border-black"/>

    <div class="md:grid-cols-2 grid gap-4 "> 
    <Project
      github={"https://github.com/Joe-Newm/libGDX-shooter-game"}
      projectName={"Zombie Survival Game"}
      tools={["java", "libGDX"]}
      link={"https://joe-newm.github.io/shooter-game-web/"}
      size="360px"
      img="/img/zombie-survival.png"
    />
    <Project
      github={"https://github.com/Joe-Newm/space-invader-clone"}
      projectName={"Space Invaders Clone"}
      tools={["java", "libGDX"]}
      link={"https://joe-newm.github.io/space-invaders-web/"}
      size="360px"
      img="/img/space.png"
    />
    </div>

    <!-- <p class="text-gray-600">Email me at j.newm500@gmail.com</p> -->

    <div class="flex flex-col md:flex-row w-full gap-4 h-full">
      <div class="flex flex-col w-full">
        <h2 class="mt-20  font-semibold">Get in Touch</h2>
            <hr class="mb-5 border-black"/>
        
        <ContactForm />
      </div>
      <!-- <div id="xterm-container"></div> -->

      <!-- <div class="flex flex-col w-full">
        <h2 class="mt-20 mb-6 font-semibold">Quick Links</h2>

        <div class="flex flex-col gap-4">
          <div
            class="bg-white border-gray-400 border flex p-5 rounded-md h-full gap-5 flex-col items-center"
          >
            <div class="justify-between w-full pb-4">
              <SocialBig
                socialName="Github"
                link="https://github.com/Joe-Newm"
              />
              <SocialBig
                socialName="Linkedin"
                link="https://linkedin.com/in/joseph-newman-a54900159"
              />
              <SocialBig
                socialName="Resume"
                link="/documents/Joseph-Newman-Resume-v7.pdf"
              />
            </div>
          </div>

        </div>
      </div> -->
    </div>

          <div
            class="mt-10 p-5 cursor-pointer bg-black flex rounded-md w-full h-16 items-center justify-center"
            onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
          >
            <img src="/logo.svg" class="h-8 invert" />
          </div>
    <!-- hidden pop up for download -->

    <div id="overlay" class="hidden fixed inset-0 bg-black bg-opacity-50 z-40">
    </div>
    <div
      id="popupDialog"
      class="fixed bottom-0 left-1/2 transform -translate-x-1/2 bg-white p-5 rounded-t-lg w-full z-50 animate-slide-up"
    >
      <div class="flex justify-end">
        <a id="x" class="cursor-pointer font-bold">X</a>
      </div>
      <h2 class="text-center font-inter">Choose Version</h2>

      <div class="flex-grow relative group">
        <a
          href="documents/josephs-pixel-art-editor-windows.zip"
          class="w-full flex justify-center items-center relative z-10 border border-gray-400 rounded-md h-14 mt-4 p-5 transition-transform duration-300 transform hover:-translate-y-2 hover:border-black bg-white font-inter"
        >
          Windows
        </a>
        <div
          class="absolute inset-0 h-10 mt-4 bg-black rounded-md opacity-0 group-hover:opacity-100 transition-opacity duration-300 ease-in-out"
        >
        </div>
      </div>

      <div class="flex-grow relative group mt-4">
        <a
          href="documents/josephs-pixel-art-editor-mac.zip"
          class="w-full text-center relative z-10 border border-gray-400 rounded-md h-14 flex justify-center items-center p-5 transition-transform duration-300 transform hover:-translate-y-2 hover:border-black bg-white font-inter"
        >
          Mac
        </a>

        <div
          class="absolute inset-0 h-10 mt-4 bg-black rounded-md opacity-0 group-hover:opacity-100 transition-opacity duration-300 ease-in-out"
        >
        </div>
      </div>
    </div>

    <style>
      #overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 199;
      }

      #popupDialog {
        display: none;
        border: 1px solid black;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background-color: white;
        padding: 20px;
        width: 40%;
        height: 50%;
        border-radius: 5px;
        z-index: 200;
      }
      @media only screen and (max-width: 700px) {
        #popupDialog {
          width: 80%;
        }
      }
    </style>
  </main>
</Layout>
