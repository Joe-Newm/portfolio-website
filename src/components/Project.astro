---
const {
  projectName = "Default Project",
  tools = [],
  link,
  github,
  openInNewTab = true,
  projectDescription,
  img,
  altText,
  size,
} = Astro.props;
import Social from "./Social.astro";
---

<div class="full-container flex">
  <div class="relative group">
    <!-- <a href={github} target="_blank" class="relative z-10 border-black border rounded-md h-14 flex justify-between items-center mt-4 p-5 transition ease-in-out duration-300 transform group-hover:-translate-y-2 group-hover:border-black gap-5 bg-black">
            <div class="flex gap-5">
                <p id="name" class="text-white">Github</p>
            </div>
            <p class="text-white text-2xl font-extralight transition-transform group-hover:translate-x-2 duration-300" style="min-width: 1.5rem;">&#8594;</p>
        </a> -->
    <!-- <div
      class="absolute inset-0 h-14 mt-4 bg-white border border-black rounded-md opacity-0 group-hover:opacity-100 transition-opacity duration-300 ease-in-out"
    >
    </div> -->
  </div>
  <div class="flex-grow">
    <div
      id="project"
      class=`card w-full shadow-md relative z-10 border-gray-400 border rounded-xl flex justify-between mt-4 p-5 gap-5 bg-gray-200`
      style={`min-height: ${size}`}
    >
      <div class="flex md:flex-col flex-col gap-4">
        <div class="rounded-md border border-1 border-gray-400 bg-white shadow-sm h-64 w-full overflow-hidden">
          <img src={img} alt={altText} class="object-cover rounded-md" />
        </div>

        <div class="text-container md:flex flex-col gap-x-5 gap-2">
          <div class="md:flex flex-col gap-2">
            <h3 id="name" class="m-0 font-bold md:mt-0 mt-4 text-xl">
              {projectName}
            </h3>
            <!-- {tools.length > 0 ? tools.join(" • ") : "N/A"} -->

            <div class="flex flex-wrap gap-4">
              {
                tools.map((tool) => (
                  <div class="h-min min-w-min pt-1 pb-1 pl-4 pr-4 bg-gray-50 rounded-md">
                    <p>{tool}</p>
                  </div>
                ))
              }
            </div>
            <hr class="border-1 border-gray-400 mt-2" />
            <iv>
              <p>{projectDescription}</p>
            </iv>
            <div class="flex gap-4">
              <Social socialName="Github Page" link={github} />
              <Social socialName="Live Website" link={link} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    #name {
      font-family: inter;
    }
    @media only screen and (max-width: 600px) {
      .full-container {
      }
      .card {
        height: auto;
      }
      .text-container {
        flex-wrap: wrap;
      }
    }
  </style>
</div>
