---
const { socialName, link } = Astro.props;
---

<a href={link} target="_blank" class="relative group block w-auto">
  <div
    class="bg-[#f06414] tracking-wider text-white font-bold justify-center w-auto relative z-10 border-[#07524b] rounded-md h-10 flex items-center mt-4 p-4 transition ease-in-out duration-300 transform group-hover:-translate-y-2 group-hover:border-black gap-5"
  >
    <div class="flex gap-5">
      <p id="name">{socialName}</p>
    </div>
  </div>

  <div
    class="w-auto absolute inset-0 h-6 mt-8 border-[#f06414] border rounded-md opacity-0 group-hover:opacity-100 transition-opacity duration-300 ease-in-out"
  >
  </div>
</a>

<style>
  #name {
    font-family: inter;
    font-size: 14px;
  }
</style>
